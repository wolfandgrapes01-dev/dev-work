import React, {
  createContext,
  useContext,
  useState,
  ReactNode,
} from "react";
import ReactDOM from "react-dom";

/* =======================
 * Types
 * ======================= */

export type ModalVariant =
  | "center"
  | "bottom"
  | "fullscreen";

/* =======================
 * Context
 * ======================= */

type ModalContextValue = {
  openModal: (
    content: ReactNode,
    variant?: ModalVariant
  ) => void;
  closeModal: () => void;
};

const ModalContext =
  createContext<ModalContextValue | null>(null);

/* =======================
 * Provider
 * ======================= */

export const ModalProvider = ({
  children,
}: {
  children: ReactNode;
}) => {
  const [state, setState] = useState<{
    content: ReactNode;
    variant: ModalVariant;
  } | null>(null);

  const openModal = (
    content: ReactNode,
    variant?: ModalVariant
  ) => {
    setState({
      content,
      variant: variant ?? "center",
    });
  };

  const closeModal = () => {
    setState(null);
  };

  return (
    <ModalContext.Provider
      value={{ openModal, closeModal }}
    >
      {children}

      {state && (
        <ModalRoot
          variant={state.variant}
          onClose={closeModal}
        >
          {state.content}
        </ModalRoot>
      )}
    </ModalContext.Provider>
  );
};

/* =======================
 * Hook
 * ======================= */

export const useModal = () => {
  const ctx = useContext(ModalContext);
  if (!ctx) {
    throw new Error(
      "useModal must be used within ModalProvider"
    );
  }
  return ctx;
};

/* =======================
 * Modal Root
 * ======================= */

const ModalRoot = ({
  children,
  variant,
  onClose,
}: {
  children: ReactNode;
  variant: ModalVariant;
  onClose: () => void;
}) => {
  return ReactDOM.createPortal(
    <div
      className="modal-backdrop"
      onClick={onClose}
    >
      <div
        className={`modal modal--${variant}`}
        onClick={(e) => e.stopPropagation()}
      >
        {children}
      </div>
    </div>,
    document.body
  );
};
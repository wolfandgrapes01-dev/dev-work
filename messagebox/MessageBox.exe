using System;
using System.Windows.Forms;

internal static class Program
{
    [STAThread]
    static void Main(string[] args)
    {
        string message = args.Length > 0
            ? args[0]
            : "Service Message";

        MessageBox.Show(
            message,
            "Warning",
            MessageBoxButtons.OK,
            MessageBoxIcon.Warning);
    }
}